# Bu faylni ".env" nomi bilan nusxalang (Copy-Item), keyin haqiqiy
# qiymatlarni kiriting. HECH QACHON haqiqiy PRIVATE_KEY bilan .env
# faylini GitHub'ga yubormang (.gitignore'ga ".env" qo'shilganiga ishonch
# hosil qiling).

# MAJBURIY: bot hamyonining private key'i. Bu hamyonda faqat GAZ uchun
# ozgina ETH bo'lsa kifoya — WBTC/USDC oldindan kerak emas, mukofotlar
# avtomatik shu yerga tushadi. Alohida, faqat shu maqsad uchun YANGI
# hamyon yaratish tavsiya etiladi (asosiy hamyoningizni ishlatmang).
PRIVATE_KEY=

# IXTIYORIY: agar standart Ankr RPC ishlamasa, boshqasini shu yerga yozing.
# RPC_URL=https://arb1.arbitrum.io/rpc

# IXTIYORIY: har necha soniyada bir tekshirilsin (standart: 30)
POLL_INTERVAL_SECONDS=30

# IXTIYORIY: true qilib qo'ysangiz, bot hech qanday haqiqiy tranzaksiya
# YUBORMAYDI — faqat nima qilishini konsolga yozib turadi. Birinchi marta
# ishga tushirishdan oldin buni "true" qilib sinab ko'rish tavsiya etiladi.
DRY_RUN=false
